@startuml
title <size:24>Container View: BiblioUNSA</size>\n<size:24>Nivel 2: contenedores internos de BiblioUNSA.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

Person(Estudiante, "Estudiante", $descr="Estudiante matriculado en la UNSA que busca y reserva libros.", $tags="", $link="")
Person(Bibliotecario, "Bibliotecario", $descr="Personal de la biblioteca encargado de gestionar préstamos y multas.", $tags="", $link="")
System(SistemaAcadémicoUNSA, "Sistema Académico UNSA", $descr="Sistema central para validar matrículas.", $tags="", $link="")
System(GoogleWorkspace, "Google Workspace", $descr="SSO para autenticación institucional.", $tags="", $link="")

System_Boundary("BiblioUNSA_boundary", "BiblioUNSA", $tags="") {
  ContainerDb(BiblioUNSA.BasedeDatos, "Base de Datos", $techn="PostgreSQL 16", $descr="Almacena información de catálogo, préstamos y multas.", $tags="", $link="")
  Container(BiblioUNSA.AplicaciónWeb, "Aplicación Web", $techn="React / PWA", $descr="Interfaz principal para estudiantes y bibliotecarios.", $tags="", $link="")
  Container(BiblioUNSA.APIREST, "API REST", $techn="Python / Django", $descr="Monolito en capas que procesa la lógica de negocio de préstamos y reservas.", $tags="", $link="")
}

Rel(Estudiante, BiblioUNSA.AplicaciónWeb, "Usa", $techn="HTTPS", $tags="", $link="")
Rel(Bibliotecario, BiblioUNSA.AplicaciónWeb, "Usa", $techn="HTTPS", $tags="", $link="")
Rel(BiblioUNSA.AplicaciónWeb, GoogleWorkspace, "Autentica usuario", $techn="OAuth 2.0", $tags="", $link="")
Rel(BiblioUNSA.AplicaciónWeb, BiblioUNSA.APIREST, "Consulta catálogo", $techn="HTTPS/JSON", $tags="", $link="")
Rel(BiblioUNSA.APIREST, SistemaAcadémicoUNSA, "Valida matrícula (ValidadorMatricula)", $techn="HTTPS/JSON", $tags="", $link="")
Rel(BiblioUNSA.APIREST, BiblioUNSA.BasedeDatos, "Lee y escribe", $techn="SQL/TCP", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml