@startuml
title <size:24>Deployment View: BiblioUNSA - Producción</size>\n<size:24>Despliegue en producción (Data Center UNSA).</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Deployment>

Deployment_Node(Producción.DispositivodelUsuario, "Dispositivo del Usuario", $type="Navegador Web (PC / Móvil)", $descr="", $tags="", $link="") {
  Container(Producción.DispositivodelUsuario.AplicaciónWeb_1, "Aplicación Web", $techn="React / PWA", $descr="Interfaz principal para estudiantes y bibliotecarios.", $tags="", $link="")
}

Deployment_Node(Producción.DataCenterUNSA, "Data Center UNSA", $type="Servidor Ubuntu 24.04 LTS, 4 vCPU, 8 GB RAM", $descr="", $tags="", $link="") {
  Deployment_Node(Producción.DataCenterUNSA.DockerCompose, "Docker Compose", $type="Docker 27", $descr="", $tags="", $link="") {
    Container(Producción.DataCenterUNSA.DockerCompose.APIREST_1, "API REST", $techn="Python / Django", $descr="Monolito en capas que procesa la lógica de negocio de préstamos y reservas.", $tags="", $link="")
    ContainerDb(Producción.DataCenterUNSA.DockerCompose.BasedeDatos_1, "Base de Datos", $techn="PostgreSQL 16", $descr="Almacena información de catálogo, préstamos y multas.", $tags="", $link="")
  }

}

Rel(Producción.DispositivodelUsuario.AplicaciónWeb_1, Producción.DataCenterUNSA.DockerCompose.APIREST_1, "Consulta catálogo", $techn="HTTPS/JSON", $tags="", $link="")
Rel(Producción.DataCenterUNSA.DockerCompose.APIREST_1, Producción.DataCenterUNSA.DockerCompose.BasedeDatos_1, "Lee y escribe", $techn="SQL/TCP", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml